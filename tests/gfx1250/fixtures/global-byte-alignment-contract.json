  "scope_distinctions": {
    "GLOBAL": "This patch enables only ordinary GLOBAL B32 on gfx1250 HSA, matching the compiler capability chain and exact coordinator physical probes.",
    "SMEM": "This GLOBAL lowering predicate does not define scalar instruction low-bit component masking. Existing explicit unsupported SMEM boundary remains separate.",
    "DS": "Separate capability and opcode-specific width/offset/hardware-bug checks exist in SIISelLowering lines2042-2148; this review proposes no DS model expansion.",
    "FLAT": "Separate path in SIISelLowering lines2150-2164 conservatively treats unknown aperture as potentially scratch. This review proposes no FLAT model expansion.",
    "buffer": "Buffer-fat/resource robust-OOB path lines2176-2188 has its own conditions and cannot be inferred from ordinary GLOBAL."
  },
  "modeled_profile": {
    "target": "gfx1250",
    "environment": "AMDHSA default unaligned-access-mode",
    "instructions": [
      "global_load_b32",
      "global_store_b32"
    ],
    "alignment_bytes": 1,
    "bounds": "Entire four-byte transfer must fit one configured array or module object before any component effect. Initialized-byte definedness and read-only checks remain unchanged.",
    "unchanged_profiles": [
      "SMEM low-bit component masking boundary",
      "DS natural-width checks",
      "FLAT alignment checks",
      "GLOBAL B64/B96/B128",
      "gfx942 and gfx950 alignment checks"
    ],
    "data": "Only already modeled raw byte/half/word representations may be transported; underalignment does not decode arbitrary symbolic word subparts."
  },
